# Per-project command journal (roadmap 19). Written beside the project it describes.
history.jsonl
build-tsan/
# configure_check's probe tree: a build directory it re-configures every run to prove CMake can
# still process this repo. Never built into, only configured; safe to delete at any time.
build-configure-probe/
# Sanitizer build trees, same reason as build-tsan. build-asan was NOT here, so a `git add -A`
# swept 34 MB of instrumented binaries into a commit — the ignore list has to name every build
# tree, not the two that happened to exist when it was written.
build-asan/
build-*/

# clangd's index, which only started appearing when CMakeLists began generating
# compile_commands.json. Same lesson as build-asan below: an ignore list has to name what
# the build ACTUALLY produces, not what it produced when the list was written.
.cache/
